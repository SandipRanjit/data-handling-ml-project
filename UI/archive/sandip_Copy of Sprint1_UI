nd({\n","            \"role\": \"assistant\",\n","            \"content\": mock_response\n","        })\n","\n","        st.rerun()\n","\n","#Peference settings\n","with st.container(border=True):\n","    col1, col2, col3 = st.columns(3)\n","\n","    with col1:\n","        st.markdown(\n","            '<div class=\"field-label\">Investment Amount</div>',\n","            unsafe_allow_html=True\n","        )\n","\n","        amount = st.number_input(\n","            \"amount\",\n","            min_value=100,\n","            max_value=1000000,\n","            value=10000,\n","            step=500,\n","            label_visibility=\"collapsed\"\n","        )\n","\n","    with col2:\n","\n","        st.markdown(\n","            '<div class=\"field-label\">Investment Sector</div>',\n","            unsafe_allow_html=True\n","        )\n","\n","        sector = st.selectbox(\n","            \"sector\",\n","            [\n","                \"All Sectors\",\n","                \"Technology\",\n","                \"Healthcare\",\n","                \"Financial Services\",\n","                \"Energy\",\n","                \"Consumer\",\n","                \"Industrials\",\n","                \"Utilities\",\n","                \"Real Estate\"\n","            ],\n","            label_visibility=\"collapsed\"\n","        )\n","\n","    with col3:\n","\n","        st.markdown(\n","            '<div class=\"field-label\">Risk Tolerance</div>',\n","            unsafe_allow_html=True\n","        )\n","\n","        risk = st.selectbox(\n","            \"risk\",\n","            [\"Low\", \"Medium\", \"High\"],\n","            index=1,\n","            label_visibility=\"collapsed\"\n","        )\n","\n","    col4, col5 = st.columns([1, 1])\n","\n","    with col4:\n","\n","        st.markdown(\n","            '<div class=\"field-label\">Investment Goal</div>',\n","            unsafe_allow_html=True\n","        )\n","\n","        goal = st.selectbox(\n","            \"goal\",\n","      
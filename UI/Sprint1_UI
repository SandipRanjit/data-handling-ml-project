47; font-weight: 700;\"\n","    else:\n","        return \"color: #FF6B6B; font-weight: 700;\"\n","\n","\n","def probability_color(value):\n","    if value < 40:\n","        return \"color: #FF6B6B; font-weight: 700;\"\n","    elif value < 70:\n","        return \"color: #F4CF47; font-weight: 700;\"\n","    else:\n","        return \"color: #69D9A3; font-weight: 700;\"\n","\n","\n","def ticker_color(value):\n","    return \"color: #00D6FF; font-weight: bold;\"\n","\n","\n","def return_color(value):\n","    return \"color: #6FCF97; font-weight: 700;\""],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Cs4-kR-ho7CZ","executionInfo":{"status":"ok","timestamp":1790600466166,"user_tz":-180,"elapsed":6,"user":{"displayName":"Olga Chitembo","userId":"15309661241161486218"}},"outputId":"3cec43dc-424d-4301-dcc7-a9d6f1600548"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["Overwriting utils.py\n"]}]},{"cell_type":"markdown","source":["# **AI Chat Interface**\n","\n","Handles the AI assistant chat functionality, including initializing chat history, displaying user and assistant messages, accepting questions, generating responses, and updating the chat dynamically."],"metadata":{"id":"QjPYjZN296xN"}},{"cell_type":"code","source":["%%writefile chat.py\n","import streamlit as st\n","\n","def initialize_chat():\n","    if \"messages\" not in st.session_state:\n","        st.session_state.messages = [\n","            {\n","                \"role\": \"assistant\",\n","                \"content\": (\n","                    \"Hi! I'm your INVESTIQ research assistant. \"\n","                    \"Ask me anything about the analyzed companies, \"\n","                    \"risk, sectors, or your investment strategy.\"\n","                )\n","            }\n","        ]\n","\n","\n","def render_chat(sparkles_svg, user_svg):\n","\n","    with st.container(border=True):\n","        st.markdown(\n","            f\"\"\"\n","            <div class=\"chat-header\">\n","                <div class=\"chat-title\">\n","                    AI CHAT\n","                </div>\n","                <div class=\"chat-badge\">\n","                    <span class=\"result-icon\">\n","                        {sparkles_svg}\n","                    </span>\n","                    AI assistant\n","                </div>\n","            </div>\n","            \"\"\",\n","            unsafe_allow_html=True\n","        )\n","\n","        chat_box = st.container(height=330, border=False)\n","\n","        with chat_box:\n","            for message in st.session_state.messages:\n","                if message[\"role\"] == \"assistant\":\n","                    st.markdown(\n","                        f\"\"\"\n","                        <div class=\"chat-message\">\n","                            <div class=\"chat-icon\">\n","                                {sparkles_svg}\n","                            </div>\n","                            <div class=\"chat-bubble\">\n","                                {message[\"content\"]}\n","                            </div>\n","                        </div>\n","                        \"\"\",\n","                        unsafe_allow_html=True\n","                    )\n","\n","                else:\n","                    st.markdown(\n","                        f\"\"\"\n","                        <div class=\"user-message\">\n","                            <div class=\"user-bubble\">\n","                                {message[\"content\"]}\n","                            </div>\n","                            <div class=\"user-icon\">\n","                                {user_svg}\n","                            </div>\n","                        </div>\n","                        \"\"\",\n","                        unsafe_allow_html=True\n","                    )\n","\n","        chat_col1, chat_col2 = st.columns([12, 1])\n","\n","        with chat_col1:\n","            user_question = st.text_input(\n","                \"Ask a question\",\n","                placeholder=\"Ask about companies, risk, sectors...\",\n","                label_visibility=\"collapsed\"\n","            )\n","\n","        with chat_col2:\n","            send = st.button(\n","                \"➤\",\n","                key=\"send_chat\"\n","            )\n","\n","        if send and user_question.strip():\n","            question = user_question.strip()\n","\n","            st.session_state.messages.append({\n","                \"role\": \"user\",\n","                \"content\": question\n","            })\n","\n","            mock_response = (\n","                \"Based on the current investment analysis, \"\n","                \"this company has a moderate risk profile. \"\n","                \"Its historical performance suggests potential \"\n","                \"for growth, although investors should consider \"\n","                \"sector volatility and diversification.\"\n","            )\n","\n","            st.session_state.messages.append({\n","                \"role\": \"assistant\",\n","                \"content\": mock_response\n","            })\n","\n","            st.rerun()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"QJvuQX0ApX1-","executionInfo":{"status":"ok","timestamp":1790600042530,"user_tz":-180,"elapsed":4,"user":{"displayName":"Olga Chitembo","userId":"15309661241161486218"}},"outputId":"a960153d-3101-4c6a-d672-43e0e1374563"},"execution_count":6,"outputs":[{"output_type":"stream","name":"stdout","text":["Writing chat.py\n"]}]},{"cell_type":"markdown","source":["# **Investment Preferences**\n","\n","Collects the user's investment preferences including investment amount, sector, risk tolerance, and investment goal. Returns these selections so they can be used to generate the investment analysis."],"metadata":{"id":"dMrhk8i3-Hz5"}},{"cell_type":"code","source":["%%writefile preferences.py\n","import streamlit as st\n","\n","d